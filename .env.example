# Postgres host: localhost when the API runs with npm run dev; docker compose overrides it to db
DB_HOST=localhost
# Port published on the host for the db container; the api container always reaches Postgres on 5432
DB_PORT=5433
DB_USERNAME=gestao_salas
# openssl rand -base64 24
DB_PASSWORD=
DB_NAME=gestao_salas
# HTTP port of the API on the host
PORT=3001
